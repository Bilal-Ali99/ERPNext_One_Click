{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erpnext-one-click.local/schemas/release-catalog-1.0.0.json",
  "title": "ERPNext One-Click release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogStatus", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogStatus": {
      "enum": ["candidate", "approved"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "erpnextMajor",
        "sourceEvidence",
        "compose",
        "images",
        "requirements",
        "promotionChecklist"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^erpnext-v(15|16)-[a-z0-9-]+$"
        },
        "status": {
          "enum": ["candidate", "approved", "retired"]
        },
        "erpnextMajor": {
          "enum": [15, 16]
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "sourceRef", "files"],
          "properties": {
            "repository": { "const": "frappe/frappe_docker" },
            "sourceRef": { "type": "string", "minLength": 1 },
            "sourceCommit": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{40}$"
            },
            "files": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["erpnext", "mariadb", "redis"],
          "properties": {
            "erpnext": { "$ref": "#/$defs/image" },
            "mariadb": { "$ref": "#/$defs/image" },
            "redis": { "$ref": "#/$defs/image" }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecture", "minimumWslVersion"],
          "properties": {
            "architecture": { "const": "x64" },
            "minimumWslVersion": { "type": "string", "minLength": 1 },
            "minimumDockerDesktopVersion": { "type": ["string", "null"] }
          }
        },
        "promotionChecklist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "approval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["approvedOn", "testedWindowsBuilds", "testedDockerDesktopVersion"],
          "properties": {
            "approvedOn": { "type": "string", "format": "date" },
            "testedWindowsBuilds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "testedDockerDesktopVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
